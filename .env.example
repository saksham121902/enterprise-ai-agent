# =============================================================================
# Enterprise AI Operations Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All values shown are defaults suitable for local development.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=Enterprise AI Agent
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-in-production
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=["*"]

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── Celery (Task Queue) ─────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── ChromaDB (Vector Store) ─────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ── Neo4j (Knowledge Graph) ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=enterprise_ai_neo4j

# ── JWT Authentication ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Providers ───────────────────────────────────────────────────────
# Primary provider: openai | anthropic | google | azure | ollama
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDERS=["anthropic", "google"]

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.0-flash

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Secrets Management ───────────────────────────────────────────────────
# Provider: env | vault | aws | azure
SECRETS_PROVIDER=env

# HashiCorp Vault
VAULT_URL=
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret

# AWS Secrets Manager
AWS_REGION=
AWS_SECRET_NAME=

# Azure Key Vault
AZURE_VAULT_URL=

# ── Multi-Tenant ─────────────────────────────────────────────────────────
DEFAULT_TENANT_NAME=default
MULTI_TENANT_ENABLED=false

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── File Upload ──────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".docx",".txt",".xlsx",".csv"]

# ── Observability ────────────────────────────────────────────────────────
OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true
JAEGER_ENABLED=true
LOG_LEVEL=INFO
# Log format: json (production) | console (development)
LOG_FORMAT=console

# ── Email (Mock by default) ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@enterprise-ai.local
