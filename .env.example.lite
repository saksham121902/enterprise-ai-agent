# =============================================================================
# Enterprise AI Operations Agent — Lite Mode Environment Template
# =============================================================================
# Copy this file to .env to run in lean/demo mode.
# In lite mode, Redis, Celery, Neo4j, and Jaeger are NOT required.
# =============================================================================

# ── Application Modes ────────────────────────────────────────────────────────
LITE_MODE=true
DEMO_MODE=true
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Security & Authentication ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/enterprise_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ── Vector Database (ChromaDB) ───────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ── CORS Settings ────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# ── LLM Providers (Configure at least ONE) ───────────────────────────────────
# Primary provider options: openai, anthropic, google, ollama
PRIMARY_PROVIDER=openai
FALLBACK_PROVIDER=google

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# Ollama (Local free LLM fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# ── Demo Mode Protection ────────────────────────────────────────────────────
# Prevents abusive usage during live portfolio demos
DEMO_RATE_LIMIT_PER_IP=30
DEMO_RATE_LIMIT_WINDOW_SECONDS=60
DEMO_DAILY_TOKEN_BUDGET=100000

# ── Default Admin Seed Credentials ──────────────────────────────────────────
ADMIN_EMAIL=admin@enterprise-ai.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123!
ADMIN_FULL_NAME=System Administrator
